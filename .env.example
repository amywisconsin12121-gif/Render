# Run npm run setup to generate .env with a real random secret.
MCP_SECRET=replace-with-a-random-secret-at-least-32-characters

# brave = broad web image search (requires your Brave Search API key).
# wikimedia = Wikimedia Commons only (no API key).
SEARCH_PROVIDER=wikimedia
BRAVE_API_KEY=
PORT=9000

# Set to your public HTTPS origin when hosting outside Render.
# Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=

# Optional: include your website or contact address for Wikimedia requests.
# OUTBOUND_USER_AGENT=ImageScout/1.0 (https://your-site.example)
